# ==============================================================================
# FoodHub Environment Variables
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database configuration
# SQLite default for local zero-dependency development:
DATABASE_URL="file:./dev.db"
# PostgreSQL example for docker/production:
# DATABASE_URL="postgresql://foodhub:foodhub_secret@localhost:5432/foodhub?schema=public"

# Redis cache & job queue (falls back to high-performance in-memory if unset/unavailable)
# REDIS_URL=redis://localhost:6379

# Security & Session
JWT_ACCESS_SECRET=dev_jwt_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_super_secure_key_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256-GCM

# Payments
PAYMENT_GATEWAY_PROVIDER=mock # mock | stripe
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key

# Notifications & SMS
SMS_PROVIDER=dev # dev | twilio
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=auth_placeholder
TWILIO_PHONE_NUMBER=+1234567890

EMAIL_PROVIDER=dev # dev | sendgrid
SENDGRID_API_KEY=SG.placeholder
EMAIL_FROM="FoodHub <noreply@foodhub.in>"

# Maps & Geo
GEO_PROVIDER=local # local | google
GOOGLE_MAPS_API_KEY=

# Frontend Vite variables
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
VITE_MAP_PROVIDER=leaflet # leaflet | google
VITE_GOOGLE_MAPS_KEY=
